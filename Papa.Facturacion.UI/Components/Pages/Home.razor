@using Papa.Facturacion.DataAccess.Context
@page "/"
@inject PapaFacturacionContext Context;

<PageTitle>Home</PageTitle>

<h1>Catálogo</h1>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Context.Catalogos)
        {
            <tr>
                <td>@item.ICatalogo</td>
                <td>@item.VNombre</td>
                <td>@item.VDescripcion</td>
            </tr>
        }
    </tbody>
</table>

