@using Papa.Facturacion.UI.Components.Pages.Features.Products.Components
@attribute [Route(ComponentRoutes.Products.Create)]

<GroupBox Class="mb-4">
    <Content>
        <div class="page-header">
            <h2 class="page-title">Registrar Producto</h2>
            <span class="page-route">@ComponentRoutes.Products.Create</span>
        </div>
    </Content>
</GroupBox>

<GroupBox Title="Datos del producto">
    <Content>
        <FormProduct ListLaboratorio="ListLaboratorio"
                     ListCategoria="ListCategoria"
                     ListMarca="ListMarca"
                     OnSaveEvent="SaveProduct"
                     Request="Request" />
    </Content>
</GroupBox>