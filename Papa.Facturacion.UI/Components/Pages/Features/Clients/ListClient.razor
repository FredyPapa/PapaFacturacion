@attribute [Route(ComponentRoutes.Clients.List)]


<GroupBox Class="mb-4">
    <Content>
        <div class="page-header">
            <h2 class="page-title">Mantenimiento de clientes</h2>
            <span class="page-route">@ComponentRoutes.Clients.List</span>
        </div>
    </Content>
</GroupBox>

<GroupBox title="Buscar clientes">
    <Content>
        <div class="row">
            <div class="col-lg-8 col-md-8 col-sm-12">
                <label>Filtro</label>
                <input class="form-control form-control-sm" @bind="Request.Filter" />
            </div>
            <div class="col-lg-4 col-md-4 col-sm-12 mt-3">
                <div class="btn btn-group btn-group-sm">
                    <button class="btn btn-outline-info" @onclick="ListClients"><i class="bi bi-search" /></button>
                    <button class="btn btn-outline-info" @onclick="Refresh"><i class="bi bi-arrow-repeat" /></button>
                    <a class="btn btn-outline-primary" href="@ComponentRoutes.Clients.Create"><i class="bi bi-plus" /> Nuevo</a>
                    <button class="btn btn-outline-success"><i class="bi bi-file-excel" /> Exportar</button>
                </div>
            </div>
        </div>
    </Content>
</GroupBox>

<GroupBox Class="mt-4">
    <Content>
        <div class="row mt-3">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>Tipo documento</th>
                            <th>Nro. documento</th>
                            <th>Apellido paterno</th>
                            <th>Apellido materno</th>
                            <th>Nombres</th>
                            <th>Dirección</th>
                            <th>Correo electrónico</th>
                            <th>Celular</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Response)
                        {
                            <tr class="text-center">
                                <td>@item.TipoDocumento</td>
                                <td>@item.NumeroDocumento</td>
                                <td>@item.ApellidoPaterno</td>
                                <td>@item.ApellidoMaterno</td>
                                <td>@item.Nombres</td>
                                <td>@item.Direccion</td>
                                <td>@item.CorreoElectronico</td>
                                <td>@item.Celular</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" @onclick="() => ToEdit(item.Id)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Delete(item)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <Pager Result="Pager" OnPageChanged="OnPager" OnPageSizeChanged="OnPager" />
    </Content>
</GroupBox>
