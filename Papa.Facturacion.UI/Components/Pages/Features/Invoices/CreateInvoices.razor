@using Papa.Facturacion.UI.Components.Pages.Features.Clients.Components
@using Papa.Facturacion.UI.Components.Pages.Features.Products.Components
@attribute [Route(ComponentRoutes.Invoices.Create)]

<GroupBox Class="mb-4">
    <Content>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-0">Registro de comprobante</h2>
                <small class="text-muted">@ComponentRoutes.Invoices.Create</small>
            </div>
        </div>
    </Content>
</GroupBox>

<div class="row g-4 mt-2">

    <!-- PANEL IZQUIERDO -->
    <div class="col-lg-4 col-md-5 col-sm-12">
        <GroupBox Title="Datos del comprobante">
            <Content>

                <!-- Acciones -->
                <div class="d-grid gap-2 mb-4">
                    <button class="btn btn-outline-primary" @onclick="() => ModalClient.ShowAsync()">
                        <i class="bi bi-person-plus me-2"></i>Agregar cliente
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => ModalProduct.ShowAsync()">
                        <i class="bi bi-box-seam me-2"></i>Agregar productos
                    </button>
                </div>

                <!-- Tipo de Comprobante -->
                <div class="mb-2">
                    <label class="form-label fw-semibold">Tipo de Comprobante</label>
                    <select class="form-select form-select-sm" @bind="Request.ITipoComprobanteCat">
                        <option value="0">-Seleccione-</option>
                        @foreach (var item in ListTipoComprobante)
                        {
                            <option value="@item.Id">@item.Valor</option>
                        }
                    </select>
                </div>

                <!-- Tipo de Pago -->
                <div class="mb-2">
                    <label class="form-label fw-semibold">Tipo de Pago</label>
                    <select class="form-select form-select-sm" @bind="Request.ITipoPagoCat">
                        <option value="0">-Seleccione-</option>
                        @foreach (var item in ListTipoPago)
                        {
                            <option value="@item.Id">@item.Valor</option>
                        }
                    </select>
                </div>

                <!-- Cliente -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body text-center">
                        <small class="text-muted">Cliente</small>
                        <h5 class="fw-bold mb-0">>@Request.NombreCliente</h5>
                    </div>
                </div>

                <!-- Totales -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="card bg-light text-center">
                            <div class="card-body p-2">
                                <small class="text-muted">Total Bruto</small>
                                <h6 class="fw-bold mb-0">@TotalBruto.ToString("##.##")</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card bg-light text-center">
                            <div class="card-body p-2">
                                <small class="text-muted">IGV</small>
                                <h6 class="fw-bold mb-0">@IGV.ToString("##.##")</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card bg-light text-center">
                            <div class="card-body p-2">
                                <small class="text-muted">Total Neto</small>
                                <h6 class="fw-bold mb-0 text-success">@TotalNeto.ToString("##.##")</h6>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button class="btn btn-outline-success" @onclick="OnSave">
                        <i class="bi bi-save me-2"></i>Guardar comprobante
                    </button>
                </div>
            </Content>
        </GroupBox>
    </div>

    <!-- PANEL DERECHO -->
    <div class="col-lg-8 col-md-7 col-sm-12">
        <GroupBox Title="Productos del pedido">
            <Content>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Marca</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in RequestProducts)
                            {
                                <tr>
                                    <td>@item.NombreProducto</td>
                                    <td>@item.Marca</td>
                                    <td class="text-end">S/ @item.DcPrecioUnitario</td>
                                    <td class="text-center">
                                        <input class="form-control form-control-sm text-center" min="1" type="number" @bind="item.ICantidad" />
                                    </td>
                                    <td class="text-end">S/ @item.DcTotal</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-danger" @onclick="() => OnRemoveProduct(item)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </Content>
        </GroupBox>
    </div>

</div>

<Modal Title="Seleccionar cliente"
       Size="ModalSize.ExtraLarge"
       UseStaticBackdrop="true"
       @ref="ModalClient">
    <BodyTemplate>
        <SelectClient SelectEvent="OnSelectClient" />
    </BodyTemplate>
</Modal>

<Modal Title="Seleccionar producto"
       Size="ModalSize.ExtraLarge"
       UseStaticBackdrop="true"
       @ref="ModalProduct">
    <BodyTemplate>
        <SelectProduct SelectEvent="OnSelectProduct" />
    </BodyTemplate>
</Modal>